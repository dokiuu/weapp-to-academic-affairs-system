/* 页面容器 */
page {
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  min-height: 100vh;
  padding: 30rpx;
}

/* 提示信息 */
.tips {
  background: rgba(255, 245, 230, 0.9);
  border: 1rpx solid #ffd666;
  border-radius: 16rpx;
  padding: 25rpx;
  margin-bottom: 30rpx;
  font-size: 24rpx;
  color: #d46b08;
  line-height: 1.6;
  text-align: center;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 15rpx rgba(255, 214, 102, 0.2);
}

/* 顶部导航栏 */
.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 25rpx 30rpx;
  margin-bottom: 30rpx;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 6rpx 25rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2d3748;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.bar button {
  background: linear-gradient(135deg, #ff6b6b, #ee5a24);
  border: none;
  border-radius: 50rpx;
  padding: 16rpx 35rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 15rpx rgba(255, 107, 107, 0.3);
  transition: all 0.3s ease;
}

.bar button::after {
  border: none;
}

.bar button:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 107, 0.3);
}

/* 表单区域 */
.form {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 6rpx 25rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.form input {
  width: 100%;
  min-height: 90rpx;
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 15rpx;
  padding: 25rpx;
  font-size: 30rpx;
  color: #2d3748;
  margin-bottom: 25rpx;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.form input:focus {
  border-color: #667eea;
  background: #fff;
  box-shadow: 0 0 0 3rpx rgba(102, 126, 234, 0.1);
}

.form textarea {
  width: 100%;
  min-height: 250rpx;
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 15rpx;
  padding: 25rpx;
  font-size: 28rpx;
  color: #2d3748;
  line-height: 1.6;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.form textarea:focus {
  border-color: #667eea;
  background: #fff;
  box-shadow: 0 0 0 3rpx rgba(102, 126, 234, 0.1);
}

.form input::placeholder,
.form textarea::placeholder {
  color: #adb5bd;
  font-size: 26rpx;
}

/* 图片上传区域 */
.imgs {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 6rpx 25rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.imgs-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2d3748;
  margin-bottom: 25rpx;
}

.imgs-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.img-box {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.img-box:active {
  transform: scale(0.95);
}

.img-box image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.img-box icon {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  padding: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.add-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #cbd5e0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #a0aec0;
  background: #f8f9fa;
  transition: all 0.3s ease;
}

.add-btn:active {
  background: #e9ecef;
  border-color: #a0aec0;
  transform: scale(0.95);
}

/* 字数统计 */
.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #a0aec0;
  margin-top: 15rpx;
}

/* 响应式设计 */
@media (max-width: 375px) {
  page {
    padding: 20rpx;
  }
  
  .bar {
    padding: 20rpx 25rpx;
  }
  
  .title {
    font-size: 30rpx;
  }
  
  .form {
    padding: 25rpx;
  }
  
  .form input {
    font-size: 28rpx;
    min-height: 80rpx;
  }
  
  .form textarea {
    font-size: 26rpx;
    min-height: 200rpx;
  }
  
  .imgs {
    padding: 25rpx;
  }
  
  .img-box,
  .add-btn {
    width: 180rpx;
    height: 180rpx;
  }
  
  .imgs-grid {
    gap: 15rpx;
  }
}

/* 暗色模式适配 */
@media (prefers-color-scheme: dark) {
  page {
    background: linear-gradient(135deg, #2d3748 0%, #4a5568 100%);
  }
  
  .tips {
    background: rgba(255, 245, 230, 0.1);
    border-color: #d46b08;
    color: #ffd666;
  }
  
  .bar,
  .form,
  .imgs {
    background: rgba(45, 55, 72, 0.95);
    border-color: rgba(255, 255, 255, 0.1);
  }
  
  .title {
    color: #e2e8f0;
  }
  
  .form input,
  .form textarea {
    background: #4a5568;
    border-color: #718096;
    color: #e2e8f0;
  }
  
  .form input:focus,
  .form textarea:focus {
    border-color: #667eea;
    background: #2d3748;
  }
  
  .add-btn {
    background: #4a5568;
    border-color: #718096;
    color: #a0aec0;
  }
  
  .add-btn:active {
    background: #2d3748;
  }
}