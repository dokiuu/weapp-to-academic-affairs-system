/* 帖子整体容器 */
.post {
  padding: 35rpx;
  background-color: #ffffff; /* 白色背景 */
  margin: 20rpx auto;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(22, 119, 255, 0.08); /* 柔和蓝色阴影 */
  border: 1rpx solid #e6f0ff;
  max-width: 92%;
}

/* 帖子头部：头像+昵称 */
.post .head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.post .avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid #e0e0e0;
}

.post .name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

/* 帖子标题 */
.post .title {
  font-size: 40rpx;
  font-weight: 600;
  color: #0a58ca; /* 深蓝色标题 */
  margin-bottom: 25rpx;
  line-height: 1.5;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #e6f0ff;
  letter-spacing: 0.5rpx;
}

/* 帖子内容 */
.post .content {
  font-size: 32rpx;
  color: #333333;
  line-height: 1.7;
  margin-bottom: 25rpx;
  white-space: pre-wrap; /* 保留换行符 */
  letter-spacing: 0.3rpx;
  text-align: justify;
}

/* 图片容器 */
.post .imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.post .imgs image {
  width: 200rpx;
  height: 200rpx;
  object-fit: cover;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 发布时间 */
.post .time {
  font-size: 24rpx;
  color: #999;
  text-align: right;
}

/* 评论区整体 */
.comments {
  padding: 0 30rpx;
  margin-top: 30rpx;
}

/* 评论项 */
.comments .cmt-item {
  display: flex;
  padding: 30rpx;
  margin: 15rpx 0;
  border-radius: 16rpx;
  background-color: #f9fbff;
  position: relative;
  border: 1rpx solid #e6f0ff;
  transition: all 0.2s ease;
}
.comments .cmt-item:hover {
  box-shadow: 0 4rpx 15rpx rgba(22, 119, 255, 0.05);
  transform: translateY(-2rpx);
}

.comments .cmt-item .avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.comments .cmt-item .body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* 点赞和回复按钮区域 */
.comments .cmt-item .actions {
  display: flex;
  margin-top: 10rpx;
  color: #888;
  font-size: 24rpx;
  align-items: center;
}

/* 点赞按钮 */
.comments .cmt-item .like-btn {
  display: flex;
  align-items: center;
  margin-right: 30rpx;
}

/* 点赞图标 */
.comments .cmt-item .like-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

/* 点赞数量 */
.comments .cmt-item .like-count {
  margin-left: 5rpx;
}

/* 回复按钮 */
.comments .cmt-item .reply-btn {
  color: #888;
  padding: 5rpx 10rpx;
  border-radius: 4rpx;
}

/* 回复输入框 */
.comments .cmt-item .reply-input {
  display: flex;
  margin-top: 15rpx;
  padding: 10rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  align-items: center;
}

.comments .cmt-item .reply-input input {
  flex: 1;
  height: 60rpx;
  background: transparent;
  padding: 0 10rpx;
}

.comments .cmt-item .reply-input button {
  margin-left: 10rpx;
  height: 50rpx;
  line-height: 50rpx;
}

/* 回复列表 */
.comments .cmt-item .sub-comments {
  margin-left: 60rpx;
  margin-top: 15rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #eee;
}

/* 回复项 */
.comments .cmt-item .sub-comment {
  display: flex;
  margin-bottom: 15rpx;
}

/* 回复者头像 */
.comments .cmt-item .sub-avatar {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
}

/* 回复内容区域 */
.comments .cmt-item .sub-body {
  flex: 1;
  margin-left: 15rpx;
  background: #f5f5f5;
  padding: 15rpx;
  border-radius: 10rpx;
}

/* 回复者昵称 */
.comments .cmt-item .sub-name {
  font-weight: bold;
  margin-right: 10rpx;
  font-size: 26rpx;
}

/* 回复内容 */
.comments .cmt-item .sub-text {
  font-size: 26rpx;
  color: #333;
}

.comments .cmt-item .name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.comments .cmt-item .cmt-actions {
  display: flex;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.comments .cmt-item .reply-btn {
  margin-right: 20rpx;
  padding: 4rpx 8rpx;
}

.comments .cmt-item .reply-input {
  display: flex;
  margin-top: 10rpx;
  padding: 10rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.comments .cmt-item .reply-content {
  flex: 1;
  height: 80rpx;
  padding: 10rpx;
  background: #fff;
  border: 1rpx solid #ddd;
  border-radius: 4rpx;
}

.comments .cmt-item .send-reply-btn {
  margin-left: 10rpx;
  padding: 0 20rpx;
  background: #007aff;
  color: white;
  border-radius: 4rpx;
}

.comments .cmt-item .sub-comments {
  margin-left: 80rpx;
  margin-top: 10rpx;
  padding-left: 20rpx;
  border-left: 2rpx solid #eee;
}

.comments .cmt-item .sub-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.comments .cmt-item .sub-content {
  margin-left: 10rpx;
  flex: 1;
}

.comments .cmt-item .sub-author {
  font-weight: bold;
  margin-right: 5rpx;
}

.comments .cmt-item .sub-text {
  color: #333;
}

.comments .cmt-item .text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.5;
}

/* 删除按钮 */
.comments .cmt-item .delete-btn {
  margin-left: auto;
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 28rpx;
  color: #1976d2; /* 蓝色文字 */
  padding: 8rpx 15rpx;
  border-radius: 8rpx;
  background-color: #e3f2fd; /* 浅蓝色背景 */
  border: 1rpx solid #1976d2; /* 蓝色边框 */
  z-index: 9999;
  transition: all 0.2s;
}
.comments .cmt-item .delete-btn:hover {
  background-color: #bbdefb;
}

.comments .cmt-item .delete-btn:hover {
  background-color: #f0f0f0;
}

/* 底部评论框 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #f8f8f8;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.footer input {
  flex: 1;
  height: 76rpx;
  padding: 0 28rpx;
  border: 1.5rpx solid #c9e0ff;
  border-radius: 38rpx;
  font-size: 28rpx;
  background-color: #ffffff;
  transition: border-color 0.2s;
}
.footer input:focus {
  border-color: #5a97ff;
  box-shadow: 0 0 0 4rpx rgba(90, 151, 255, 0.1);
}

.footer input:focus {
  border-color: #1a73e8; /* 聚焦时边框变蓝 */
  outline: none;
}

.footer button {
  margin-left: 20rpx;
  width: 140rpx;
  height: 70rpx;
  font-size: 28rpx;
  background-color: #1976d2; /* 主蓝色按钮 */
  border-color: #1976d2;
  border-radius: 35rpx;
  color: white;
  box-shadow: 0 2rpx 8rpx rgba(25, 118, 210, 0.3);
  transition: background-color 0.2s;
}
.footer button:hover {
  background-color: #1565c0;
}

/* 可选：为发送按钮添加悬停效果（需要在 button 组件上添加 hover-class） */
/* 在 WXML 中为 button 添加 hover-class="btn-hover" */
.btn-hover {
  background-color: #1557b0 !important;
  border-color: #1557b0 !important;
}