/* pages/clubManage/clubManage.wxss */
.manage-container {
  padding: 30rpx;
  min-height: 100vh;
  background: #f5f7fa;
}

.manage-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.add-btn {
  background: #07C160;
  color: white;
  border: none;
  border-radius: 10rpx;
  padding: 15rpx 25rpx;
  font-size: 26rpx;
}

.add-btn::after {
  border: none;
}

.club-item {
  background: white;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.club-poster {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  margin-right: 25rpx;
}

.club-info {
  flex: 1;
}

.club-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.club-desc {
  font-size: 24rpx;
  color: #666;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.edit-btn, .delete-btn {
  border: none;
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
}

.edit-btn {
  background: #3498db;
  color: white;
}

.delete-btn {
  background: #e74c3c;
  color: white;
}

.edit-btn::after, .delete-btn::after {
  border: none;
}

/* 模态框样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  background: white;
  border-radius: 20rpx;
  width: 85%;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-header text {
  font-size: 32rpx;
  font-weight: bold;
}

.close {
  font-size: 40rpx;
  color: #999;
}

.form {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: 500;
}

input, textarea {
  border: 1rpx solid #ddd;
  border-radius: 10rpx;
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

textarea {
  height: 150rpx;
}

.upload-area {
  border: 2rpx dashed #ddd;
  border-radius: 10rpx;
  padding: 40rpx;
  text-align: center;
  color: #999;
}

.preview-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
}

.submit-btn {
  background: #07C160;
  color: white;
  border: none;
  border-radius: 10rpx;
  padding: 25rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.submit-btn::after {
  border: none;
}