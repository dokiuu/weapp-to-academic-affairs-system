/* 简约卡片样式 */
.post-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin: 0 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  overflow: hidden;
}

.post-card:hover {
  transform: translateY(-5rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.post-card:active {
  transform: translateY(2rpx);
}

/* 滚动区域 */
.forum-scroll-view {
  height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 0;
}

/* 页面标题样式 */
.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #222;
  text-align: center;
  margin: 20rpx 0 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.post-card:active {
  transform: scale(0.98);
  background: #f8f9fa;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.author-info {
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.post-time {
  font-size: 24rpx;
  color: #999;
}

.post-content {
  margin-bottom: 24rpx;
}

.post-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.post-preview {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.post-footer {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.stats {
  display: flex;
  align-items: center;
  gap: 40rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.6;
}

.stat-count {
  font-size: 24rpx;
  color: #999;
}

/* 删除按钮样式 */
.delete-btn {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background-color: #ff4d4f;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  z-index: 10;
  transition: all 0.2s ease;
}

.delete-btn:hover {
  background-color: #ff7875;
  transform: scale(1.1);
}

.post-header {
  position: relative;
  display: flex;
  align-items: center;
  padding: 20rpx;
}

/* 防止删除按钮点击时触发详情跳转 */
.post-card {
  position: relative;
}