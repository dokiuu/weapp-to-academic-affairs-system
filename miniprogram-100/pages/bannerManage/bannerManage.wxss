/* pages/bannerManage/bannerManage.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: white;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.add-btn {
  background-color: #1890ff;
  color: white;
  border: none;
  padding: 15rpx 25rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  box-shadow: 0 4rpx 6rpx rgba(24, 144, 255, 0.3);
  transition: all 0.3s ease;
}

.add-btn:active {
  background-color: #096dd9;
  transform: scale(0.95);
}

.banner-list {
  height: calc(100vh - 200rpx); /* 大致减去 header 和 padding 的高度 */
}

.banner-item {
  display: flex;
  background-color: white;
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: box-shadow 0.3s ease;
}

.banner-item:hover {
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.banner-preview {
  width: 180rpx;
  height: 120rpx;
  border-radius: 8rpx;
  object-fit: cover;
  margin-right: 20rpx;
  flex-shrink: 0; /* 防止图片被压缩 */
  cursor: pointer;
}

.banner-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
}

.banner-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #262626;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.banner-date {
  font-size: 24rpx;
  color: #8c8c8c;
}

.banner-actions {
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  align-items: flex-end;
}

.action-btn {
  margin: 5rpx 0;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
}

.edit-btn {
  background-color: #e6f7ff;
  color: #1890ff;
}

.edit-btn:active {
  background-color: #bae7ff;
  transform: scale(0.95);
}

.delete-btn {
  background-color: #fff2e8;
  color: #ff7a45;
}

.delete-btn:active {
  background-color: #ffd8bf;
  transform: scale(0.95);
}

.loading-container, .empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 20rpx;
}

.loading-text, .empty-text {
  font-size: 28rpx;
  color: #8c8c8c;
}