.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 20rpx;
}

/* 标题区域 */
.title-section {
  text-align: center;
  margin: 40rpx 0 60rpx;
}

.main-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2c3e50;
  display: block;
  margin-bottom: 20rpx;
}

effective-date {
  font-size: 26rpx;
  color: #7f8c8d;
}

/* 欢迎语 */
.intro {
  font-size: 28rpx;
  color: #34495e;
  line-height: 1.6;
  margin-bottom: 30rpx;
  text-align: justify;
}

/* 协议内容容器 */
.agreement-content {
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
  padding: 40rpx;
}

/* 章节样式 */
.chapter {
  margin-bottom: 40rpx;
}

.chapter-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 20rpx;
  display: block;
  border-left: 8rpx solid #6a11cb;
  padding-left: 20rpx;
}

/* 小节样式 */
.section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #34495e;
  margin-bottom: 15rpx;
  display: block;
}

/* 条款样式 */
.clause {
  margin-bottom: 25rpx;
  padding-left: 20rpx;
}

.clause-number {
  font-weight: 500;
  color: #2c3e50;
  display: block;
  margin-bottom: 8rpx;
}

.clause-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  text-align: justify;
}

/* 滚动区域 */
.content {
  height: calc(100vh - 200rpx);
  padding-bottom: 40rpx;
}