<!-- pages/my/mypublish.wxml -->
<view class="container">
  <!-- 标题栏 -->
  <view class="page-header">
    <text class="header-title">我的发布</text>
  </view>
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-container">
    <loading />
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{goodsList.length === 0 && !loading}}" class="empty-container">
    <image src="/images/empty-publish.png" class="empty-image" />
    <text class="empty-title">暂无发布商品</text>
    <text class="empty-desc">快去发布你的闲置好物吧！</text>
    <button class="primary-btn go-publish-btn" bindtap="goToPublish">
      去发布
    </button>
  </view>

  <!-- 商品列表 -->
  <scroll-view wx:else scroll-y class="goods-list">
    <view wx:for="{{goodsList}}" wx:key="_id" class="goods-card">
      <!-- 商品图片 -->
      <image src="{{item.images[0] || '/images/default-goods.png'}}" class="goods-image" mode="aspectFill" />

      <view class="goods-info">
        <!-- 标题 -->
        <view class="goods-title">
          {{item.title}}
        </view>

        <!-- 价格 -->
        <view class="goods-price">
          ¥{{item.price}}
        </view>

        <!-- 状态标签 -->
        <view class="status-tag {{item.status === 0 ? 'status-on' : 'status-off'}}">
          {{item.status === 0 ? '上架中' : '已下架'}}
        </view>
      </view>

      <!-- 操作菜单 -->
      <view class="action-menu">
        <!-- <button class="action-btn edit-btn" bindtap="onEdit" data-id="{{item._id}}">✏️ 编辑</button> -->
        <!-- <button 
          wx:if="{{item.status === 0}}" 
          class="action-btn off-btn" 
          bindtap="onToggleStatus" 
          data-id="{{item._id}}" 
          data-status="1"
        >
          ⬇️ 下架
        </button> -->
        <!-- <button 
          wx:else 
          class="action-btn on-btn" 
          bindtap="onToggleStatus" 
          data-id="{{item._id}}" 
          data-status="0"
        > -->
          <!-- ⬆️ 重新上架
        </button> -->
        <button class="action-btn delete-btn" bindtap="onDelete" data-id="{{item._id}}">🗑️ 删除</button>
      </view>
    </view>
  </scroll-view>
</view>