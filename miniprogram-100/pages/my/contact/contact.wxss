/* contact.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 20rpx;
}

/* 页面头部 */
.page-header {
  text-align: center;
  padding: 40rpx 0;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2c3e50;
}

/* 联系卡片 */
.contact-card {
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.08);
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.card-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 10rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #7f8c8d;
}

/* 二维码容器 */
.qrcode-container {
  display: flex;
  justify-content: center;
  margin: 20rpx 0 40rpx;
  position: relative;
}

.qrcode {
  width: 320rpx;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  z-index: 1;
}

.qrcode-border {
  position: absolute;
  width: 340rpx;
  height: 340rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
  top: -10rpx;
  z-index: 0;
}

/* 联系信息 */
.contact-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #34495e;
}

.icon {
  margin-right: 16rpx;
  font-size: 32rpx;
}

/* 声明区域 */
.statement-section {
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.08);
  padding: 30rpx 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f1f3f6;
}

.statement-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.statement-item {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  position: relative;
  padding-left: 40rpx;
}

.statement-item::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #6a11cb;
}

/* 底部版权 */
.footer {
  text-align: center;
  margin-top: 60rpx;
  padding: 20rpx 0;
}

.copyright {
  font-size: 24rpx;
  color: #95a5a6;
}