/* pages/my/mydetail.wxss */
/* 容器样式 */
/* 容器样式 */
.container {
  padding: 40rpx;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  background-attachment: fixed;
}

/* 头部标题 */
.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
}

/* 分区样式 */
.avatar-section,
.nickname-section {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 36rpx;
  backdrop-filter: blur(12rpx);
  box-shadow: 0 10rpx 36rpx rgba(0,0,0,0.12);
  transition: all 0.3s ease;
}

.avatar-section:hover,
.nickname-section:hover,
.signature-section:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 14rpx 40rpx rgba(0,0,0,0.15);
}

.section-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 25rpx;
}

/* 头像区域 */
.avatar-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #e0e0e0;
  background: #f8f9fa;
}

.avatar-btn {
  background: linear-gradient(45deg, #4facfe 0%, #00f2fe 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 18rpx 36rpx;
  font-size: 26rpx;
  box-shadow: 0 6rpx 16rpx rgba(79, 172, 254, 0.35);
  transition: all 0.3s ease;
}

.avatar-btn::after {
  border: none;
}

.avatar-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 6rpx rgba(255, 107, 107, 0.3);
}

/* 昵称输入区域 - 重点修复 */
.input-container {
  position: relative;
}

.nickname-input, .signature-input {
  width: 100%;
  height: 110rpx;
  line-height: 110rpx;
  background: #ffffff;
  border: 1rpx solid #999;
  border-radius: 10rpx;
  padding: 0 100rpx 0 25rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.nickname-input:focus, .signature-input:focus {
  border-color: #667eea;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
}

.signature-input {
  height: 100rpx;
}

.nickname-input:focus {
  border-color: #667eea;
  background: #fff;
}

.placeholder {
  color: #adb5bd;
  font-size: 26rpx;
}

.char-count {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx;
  color: #6c757d;
  background: rgba(255, 255, 255, 0.9);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.confirm-btn {
  flex: 2;
  background: linear-gradient(45deg, #6a85b6 0%, #5d54a4 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 25rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(106, 133, 182, 0.45);
  transition: all 0.3s ease;
}

.confirm-btn:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 12rpx 32rpx rgba(106, 133, 182, 0.5);
}

.confirm-btn::after {
  border: none;
}

.confirm-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 3rpx 10rpx rgba(102, 126, 234, 0.4);
}

.cancel-btn {
  flex: 1;
  background: rgba(255, 255, 255, 0.9);
  color: #6c757d;
  border: 2rpx solid #e9ecef;
  border-radius: 50rpx;
  padding: 25rpx;
  font-size: 30rpx;
}

.cancel-btn::after {
  border: none;
}

.cancel-btn:active {
  background: rgba(255, 255, 255, 0.8);
}

/* 预览区域 */
.preview-section {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 24rpx;
  padding: 36rpx;
  margin-top: 40rpx;
  text-align: center;
  box-shadow: 0 10rpx 36rpx rgba(0,0,0,0.12);
  border: 1rpx solid rgba(255,255,255,0.5);
}

.preview-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 25rpx;
}

.preview-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.preview-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid #e0e0e0;
}

.preview-nickname {
  font-size: 26rpx;
  color: #555;
  font-weight: 500;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .container {
    padding: 30rpx;
  }
  
  .title {
    font-size: 32rpx;
  }
  
  .action-buttons {
    flex-direction: column;
  }
  
  .confirm-btn,
  .cancel-btn {
    flex: none;
    width: 100%;
  }
}