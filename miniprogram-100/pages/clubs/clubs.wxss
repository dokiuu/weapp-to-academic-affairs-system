/* 容器样式 - 确保高度设置正确 */
.clubs-container {
  padding: 0;
  background: linear-gradient(135deg, #f5f7fa 0%, #e4efe9 100%);
  height: 100vh; /* 使用100vh确保全屏高度 */
  display: flex;
  flex-direction: column;
  position: relative;
}

/* 头部样式 */
.header {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  padding: 30rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  position: sticky;
  top: 0;
  z-index: 100;
  flex-shrink: 0; /* 防止头部被压缩 */
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title-section {
  flex: 1;
}

.title {
  display: block;
  font-size: 38rpx;
  font-weight: bold;
  color: #2d3748;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #718096;
}

.manage-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.3);
}

.manage-btn::after {
  border: none;
}

/* 主要内容区域 - 可滚动 */
.main-content {
  flex: 1; /* 占据剩余空间 */
  height: 100%;
  overflow: hidden;
}

/* 瀑布流布局 */
.waterfall-container {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  margin-bottom: 50rpx;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 25rpx;
}

/* 社团卡片样式 */
.club-item {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  backdrop-filter: blur(10rpx);
}

.club-item:active {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
}

.club-poster {
  width: 100%;
  height: 300rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.club-info {
  padding: 25rpx;
}

.club-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #2d3748;
  margin-bottom: 12rpx;
  line-height: 1.3;
}

.club-desc {
  display: block;
  font-size: 24rpx;
  color: #718096;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 加载状态 */
.loading, .error, .empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 30rpx;
  text-align: center;
}

.loading-icon, .error-icon, .empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.7;
}

.loading text {
  font-size: 28rpx;
  color: #667eea;
}

.error-text {
  font-size: 28rpx;
  color: #e53e3e;
  margin-bottom: 30rpx;
}

.retry-btn {
  background: linear-gradient(135deg, #fc8181 0%, #f56565 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 26rpx;
}

.retry-btn::after {
  border: none;
}

.empty-text {
  font-size: 32rpx;
  color: #4a5568;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.empty-tip {
  font-size: 26rpx;
  color: #718096;
  margin-bottom: 40rpx;
}

.add-first-btn {
  background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 50rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.add-first-btn::after {
  border: none;
}

/* 回到顶部按钮 */
.back-to-top {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 25rpx rgba(102, 126, 234, 0.4);
  z-index: 1000;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .waterfall-container {
    gap: 15rpx;
    padding: 20rpx;
  }
  
  .club-poster {
    height: 250rpx;
  }
  
  .club-info {
    padding: 20rpx;
  }
  
  .club-name {
    font-size: 28rpx;
  }
  
  .club-desc {
    font-size: 22rpx;
  }
}