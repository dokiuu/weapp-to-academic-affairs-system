/* 发布商品页样式 */

.container {
  padding: 30rpx;
  background-color: #f8f8f8;
}

.form-item {
  background: white;
  padding: 30rpx;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.form-item:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.label {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required::after {
  content: " *";
  color: #e64340;
}

.input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.input:focus {
  border-color: #07c160;
  box-shadow: 0 0 0 4rpx rgba(7, 193, 96, 0.1);
  outline: none;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: 1.5;
}

.error {
  display: block;
  color: #e64340;
  font-size: 24rpx;
  margin-top: 10rpx;
  min-height: 24rpx;
}

.tips {
  display: block;
  color: #999;
  font-size: 24rpx;
  margin-top: 10rpx;
}

/* 图片上传区域 */
.image-uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.delete-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0,0,0,0.7);
  color: white;
  border-radius: 50%;
  font-size: 24rpx;
  line-height: 40rpx;
  text-align: center;
  padding: 0;
  min-width: auto;
}

.add-image-btn {
  width: 160rpx;
  height: 160rpx;
  background-color: #f5f5f5;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  font-size: 60rpx;
  color: #999;
  line-height: 160rpx;
  text-align: center;
}

/* 二维码上传区域 */
.qr-uploader {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.qr-image {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
}

.upload-qr-btn, .delete-qr-btn {
  width: 200rpx;
  height: 80rpx;
  font-size: 28rpx;
  border-radius: 10rpx;
}

.upload-qr-btn {
  background-color: #07c160;
  color: white;
}

.delete-qr-btn {
  background-color: #fa5151;
  color: white;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #07c160 0%, #06b358 100%);
  color: white;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 48rpx;
  margin-top: 50rpx;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.25);
  transition: all 0.3s ease;
}

.submit-btn:not(:disabled):active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.2);
}

.submit-btn:disabled {
  background-color: #ccc;
}
