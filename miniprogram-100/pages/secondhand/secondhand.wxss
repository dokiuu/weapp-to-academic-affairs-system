/* 全局样式 */
.container {
  background-color: #f5f9ff;
  min-height: 100vh;
  padding: 0;
  width: 100%;
  box-sizing: border-box;
  margin: 0;
}

page {
  margin: 0;
  padding: 0;
  width: 100%;
}


/* 标题栏 */
  .header {
    width: 100%;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .welcome-section {
    position: relative;
    height: 140rpx;
    width: 100%;
    border-radius: 0;
    overflow: hidden;
    box-shadow: 0 4rpx 16rpx rgba(13, 71, 161, 0.2);
  }

  .welcome-bg {
    width: 100%;
    height: 100%;
    opacity: 0.9;
    background-color: #5cc4fc;
  }

  .welcome-content {
    position: absolute;
    top: 50%;
    left: 30rpx;
    transform: translateY(-50%);
    z-index: 2;
  }

  .welcome-title {
    display: block;
    font-size: 38rpx;
    font-weight: bold;
    color: white;
    margin-bottom: 10rpx;
    text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  }

  .welcome-subtitle {
    display: block;
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
  }















.publish-btn {
  position: fixed;
  bottom: 80rpx;
  right: 30rpx;
  width: 180rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #1e88e5, #0d47a1);
  display: flex;
  justify-content: center;
  align-items: center;
  color: white;
  font-size: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(30, 136, 229, 0.5);
  z-index: 999;
  border: none;
}

.publish-btn:hover {
  transform: scale(1.05);
  box-shadow: 0 12rpx 36rpx rgba(30, 136, 229, 0.6);
}

.btn-icon {
  display: none;
}

.btn-text {
  font-weight: 500;
  font-size: 28rpx;
}

.publish-btn:active {
  transform: scale(0.96);
  background-color: #f0f8ff;
  box-shadow: 0 2rpx 8rpx rgba(255, 255, 255, 0.2);
}

/* 瀑布流容器 */
.waterfall-container {
  display: flex;
  justify-content: space-between;
  padding: 0 16rpx;
  margin-top: 20rpx;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.waterfall-column {
  flex: 0 0 calc(50% - 10rpx);
  margin: 0;
  min-width: 0;
}

/* 商品卡片 */
.goods-card {
  background-color: white;
  border-radius: 20rpx;
  overflow: hidden;
  margin: 0 0 24rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  position: relative;
}

.goods-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #1e88e5, #64b5f6);
}

.goods-card:hover {
  transform: translateY(-5rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}
.goods-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 商品图片 - 正方形 */
.image-wrapper {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 100%; /* 恢复正方形比例 */
  overflow: hidden;
  border-radius: 28rpx 28rpx 0 0;
}

.goods-image {
  position: absolute;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 28rpx 28rpx 0 0;
  transition: transform 0.4s ease;
}

.goods-card:active .goods-image {
  transform: scale(1.05);
}

.image-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.15), transparent);
  z-index: 1;
}

.price-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background-color: #ff5722;
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  z-index: 2;
  box-shadow: 0 4rpx 12rpx rgba(255, 87, 34, 0.3);
}

/* 商品信息区 */
.info-section {
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  height: auto;
}

.goods-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.5;
  max-height: 90rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  border-top: 1rpx solid #f5f5f5;
}

.publisher-info {
  display: flex;
  align-items: center;
  padding-top: 4rpx;
}
.avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  object-fit: cover;
}

.goods-title {
  font-size: 28rpx;
  line-height: 38rpx;
  max-height: 76rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 4rpx;
}

.price-tag {
  margin: 6rpx 0;
  height: 40rpx;
  display: flex;
  align-items: center;
}

.user-info {
  margin-top: 6rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
}

.goods-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a237e;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.2;
  min-height: auto;
  letter-spacing: 0.5rpx;
}

.goods-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  color: #64b5f6;
  font-weight: 400;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  color: #666;
  margin-top: 8rpx;
}

.location {
  font-size: 28rpx;
  color: #424242;
  display: flex;
  align-items: center;
}

.time {
  font-size: 26rpx;
  color: #64b5f6;
  font-weight: 400;
}

/* 发布者信息 */
.publisher-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  border: 3rpx solid #e3f2fd;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.goods-card:active .avatar {
  transform: scale(1.05);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.nickname {
  font-size: 24rpx;
  color: #424242;
  font-weight: 400;
}

/* 无数据提示 */
.no-data {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 0 100rpx;
  text-align: center;
}

.empty-img {
  width: 320rpx;
  height: 320rpx;
  margin-bottom: 40rpx;
  opacity: 0.7;
  transition: all 0.3s ease;
}

.empty-text {
  font-size: 40rpx;
  color: #1e88e5;
  margin-bottom: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.empty-subtext {
  font-size: 30rpx;
  color: #64b5f6;
  margin-bottom: 50rpx;
  text-align: center;
  padding: 0 60rpx;
  line-height: 1.5;
}

.empty-btn {
  background: linear-gradient(135deg, #1e88e5, #0d47a1);
  color: white;
  border-radius: 50rpx;
  font-size: 34rpx;
  padding: 0 80rpx;
  height: 90rpx;
  line-height: 90rpx;
  box-shadow: 0 6rpx 24rpx rgba(30, 136, 229, 0.35);
  transition: all 0.3s ease;
  border: none;
  position: relative;
  overflow: hidden;
}

.empty-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition: left 0.5s;
}

.empty-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(30, 136, 229, 0.45);
}

.empty-btn:active::before {
  left: 100%;
}

/* 回到顶部按钮 */
.scroll-top {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1e88e5, #0d47a1);
  color: white;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(30, 136, 229, 0.4);
  transition: all 0.3s ease;
  z-index: 99;
  border: none;
  opacity: 0.9;
}

.scroll-top:active {
  transform: scale(0.95);
  box-shadow: 0 6rpx 24rpx rgba(30, 136, 229, 0.5);
  opacity: 1;
}

.icon {
  font-size: 48rpx;
  font-weight: bold;
  transition: transform 0.3s ease;
}

.scroll-top:active .icon {
  transform: translateY(-4rpx);
}

/* 加载更多提示 */
.load-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.load-text {
  font-size: 28rpx;
  color: #64b5f6;
  font-weight: 400;
}

/* 响应式调整 */
@media screen and (max-width: 360px) {
  .header-content {
    padding: 0 24rpx;
  }
  
  .title {
    font-size: 36rpx;
  }
  
  .publish-btn {
    font-size: 28rpx;
    height: 68rpx;
    line-height: 68rpx;
    padding: 0 26rpx;
  }
  
  .waterfall-container {
    padding: 20rpx;
  }
  
  .info-section {
    padding: 24rpx;
  }
  
  .goods-title {
    font-size: 32rpx;
  }
}

.goods-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 轮播图区域 */
.banner-section {
  position: relative;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.banner-swiper {
  height: 300rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.2);
}

.banner-item {
  width: 100%;
  height: 100%;
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

.banner-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 25rpx;
  background: linear-gradient(transparent 0%, rgba(0, 0, 0, 0.7) 100%);
  color: white;
}

.banner-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  color: white;
  display: block;
}

.banner-desc {
  font-size: 26rpx;
  opacity: 0.9;
  color: rgba(255, 255, 255, 0.9);
  display: block;
}

.banner-indicator {
  position: absolute;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 10rpx;
  z-index: 2;
}

.banner-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  transition: all 0.3s ease;
}

.banner-dot.active {
  width: 30rpx;
  background: #1890ff;
  border-radius: 6rpx;
}

.banner-edit-btn {
  position: absolute;
  top: 15rpx;
  right: 15rpx;
  width: 50rpx;
  height: 50rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
}

.edit-icon {
  width: 30rpx;
  height: 30rpx;
}

/* 快捷管理按钮 */
.quick-manage-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  padding: 10rpx 20rpx;
  border-radius: 25rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #333;
  z-index: 10;
}

.manage-icon {
  width: 24rpx;
  height: 24rpx;
}