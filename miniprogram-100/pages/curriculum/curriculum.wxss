/* 顶部操作栏 */
/* 头部栏 - 蓝色风格 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 30rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.2);
}

.current-week-display {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: white;
}

.set-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 20rpx;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
}

.refresh-info {
  display: flex;
  align-items: center;
}

.update-time {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-right: 25rpx;
}

.refresh-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 25rpx;
  background: rgba(255, 255, 255, 0.2);
  color: white;
  border-radius: 25rpx;
  font-size: 26rpx;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.refresh-icon {
  width: 28rpx;
  height: 28rpx;
  margin-left: 10rpx;
  filter: brightness(0) invert(1);
}

/* 容器 */
.container {
  padding: 0;
  background: linear-gradient(180deg, #f0f8ff 0%, #e6f7ff 100%);
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 周选择器 - 蓝色风格 */
.week-selector {
  height: 90rpx;
  white-space: nowrap;
  width: 100%;
  overflow-x: scroll;
  -webkit-overflow-scrolling: touch;
  background: white;
  padding: 15rpx 20rpx;
  border-bottom: 2rpx solid #e6f7ff;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.1);
}

.week-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #f0f8ff;
  color: #1890ff;
  padding: 0 30rpx;
  margin: 0 12rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 500;
  border: 2rpx solid #e6f7ff;
  transition: all 0.3s ease;
}

.week-item.active {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: white;
  border-color: #1890ff;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
  transform: translateY(-2rpx);
}

/* 课程表滚动区域 */
.schedule-scroll {
  flex: 1;
  height: 100%;
  background: transparent;
}

/* 课程表容器 */
.schedule-container {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.1);
  margin: 20rpx;
  border: 1rpx solid #e6f7ff;
}

/* 表头 - 蓝色风格 */
.schedule-header {
  display: flex;
  border-bottom: 2rpx solid #e6f7ff;
  background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
}

.time-header, .day-header {
  padding: 20rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #096dd9;
  font-weight: bold;
}

.time-header {
  width: 150rpx;
  flex-shrink: 0;
  background: rgba(230, 247, 255, 0.8);
}

.day-header {
  flex: 1;
  min-width: 0;
}

/* 日期显示 */
.date-text {
  display: block;
  font-size: 22rpx;
  color: #69c0ff;
  margin-top: 5rpx;
  font-weight: normal;
}

/* 课程表主体 */
.schedule-body {
  display: flex;
  background: white;
}

/* 时间列 */
.time-column {
  width: 150rpx;
  flex-shrink: 0;
  background: #fafdff;
}

.time-slot {
  height: 130rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #595959;
  border-bottom: 1rpx solid #f0f8ff;
  text-align: center;
  background: #fafdff;
  font-weight: 500;
}

/* 课程列 */
.classes-column {
  flex: 1;
  display: flex;
  min-width: 0;
}

.day-column {
  flex: 1;
  min-width: 0;
  background: white;
}

.class-slot {
  height: 130rpx;
  border-bottom: 1rpx solid #f0f8ff;
  border-right: 1rpx solid #f0f8ff;
  padding: 8rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
  background: white;
}

.class-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 12rpx;
  border-radius: 12rpx;
  margin-bottom: 6rpx;
  background: #f0f8ff;
  border-left: 4rpx solid #bae7ff;
  transition: all 0.2s ease;
}

.class-item.has-class {
  background: linear-gradient(135deg, #e6f7ff 0%, #d6e4ff 100%);
  border-left: 4rpx solid #1890ff;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.1);
}

.class-item.has-class:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 4rpx rgba(24, 144, 255, 0.2);
}

.course-name {
  font-size: 20rpx;
  color: #262626;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.2;
}

.class-room {
  font-size: 18rpx;
  color: #597ef7;
  margin-top: 3rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 空状态 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #8c8c8c;
  font-size: 28rpx;
}

.empty-img {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 25rpx;
  opacity: 0.6;
}

/* 课程详情弹窗 - 蓝色风格 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  backdrop-filter: blur(5rpx);
}

.modal-content {
  width: 85%;
  max-width: 650rpx;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(24, 144, 255, 0.2);
  border: 1rpx solid #e6f7ff;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #e6f7ff;
  font-size: 32rpx;
  font-weight: bold;
  color: #096dd9;
  background: linear-gradient(135deg, #f0f8ff 0%, #e6f7ff 100%);
}

.close-btn {
  font-size: 38rpx;
  color: #8c8c8c;
}

.modal-body {
  padding: 30rpx;
  background: white;
}

.detail-item {
  display: flex;
  margin-bottom: 22rpx;
  line-height: 1.6;
  align-items: flex-start;
}

.label {
  width: 120rpx;
  color: #595959;
  font-size: 28rpx;
  flex-shrink: 0;
  font-weight: 500;
}

.value {
  flex: 1;
  color: #262626;
  font-size: 28rpx;
  font-weight: 500;
  word-break: break-all;
}

/* 设置面板 - 蓝色风格 */
.setting-panel {
  width: 80%;
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  border: 1rpx solid #e6f7ff;
}

.tip-text {
  display: block;
  text-align: center;
  color: #595959;
  margin-bottom: 40rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.button-group {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
  gap: 20rpx;
}

.btn-cancel {
  flex: 1;
  background: #f5f5f5;
  color: #595959;
  border-radius: 12rpx;
  border: 1rpx solid #d9d9d9;
  font-weight: 500;
}

.btn-confirm {
  flex: 1;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: white;
  border-radius: 12rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

/* 大刷新按钮 */
.refresh-btn-large {
  margin-top: 30rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: white;
  border-radius: 12rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.refresh-btn-large:active {
  transform: translateY(1rpx);
  box-shadow: 0 2rpx 6rpx rgba(24, 144, 255, 0.3);
}

/* 下拉刷新样式 */
.refresher__loading {
  color: #1890ff;
}

/* 响应式调整 */
@media (max-width: 768px) {
  .header-bar {
    padding: 20rpx 25rpx;
  }
  
  .week-item {
    padding: 0 25rpx;
    margin: 0 8rpx;
    font-size: 24rpx;
  }
  
  .time-header, .day-header {
    font-size: 24rpx;
    padding: 15rpx 0;
  }
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.schedule-container {
  animation: fadeIn 0.3s ease-out;
}

.class-item.has-class {
  animation: fadeIn 0.2s ease-out;
}