<div  class="calendar" style="display: flex;margin-top: 150rpx;" ></div>



<!-- 顶部刷新区域 -->
<view class="container">
  <!-- 顶部操作栏 -->
  <view class="header-bar">
    <view class="current-week-display" bindtap="showWeekSettingPanel">
      <text>第{{currentWeek+1}}周</text>
      <text class="set-text">设置</text>
    </view>
    <view class="refresh-info">
      <text class="update-time">更新:{{lastUpdateTime}}</text>
      <view class="refresh-btn" bindtap="onRefresh">
          刷新
        <!-- <image class="refresh-icon" /> -->
      </view>
    </view>
  </view>

  <!-- 周选择器 -->
  <scroll-view class="week-selector" scroll-x>
    <view wx:for="{{weeks}}" wx:key="index" 
          class="week-item {{currentWeek === index ? 'active' : ''}}"
          bindtap="switchWeek" data-week="{{index}}">
      第{{item}}周
    </view>
  </scroll-view>
  
  <!-- 课程表 -->
  <scroll-view class="schedule-scroll" scroll-y
    refresher-enabled
    refresher-triggered="{{isRefreshing}}"
    bindrefresherrefresh="onRefresh">
    
    <view class="schedule-container" wx:if="{{!isEmpty}}">
      <!-- 表头 - 添加日期显示 -->
      <view class="schedule-header">
        <view class="time-header">时间/日期</view>
        <view wx:for="{{weekDays}}" wx:key="index" class="day-header">
          <text>{{item}}</text>
          <text class="date-text" wx:if="{{currentDates[index]}}">{{currentDates[index]}}</text>
        </view>
      </view>

      <!-- 课程内容 -->
      <view class="schedule-body">
        <!-- 时间轴 -->
        <view class="time-column">
          <view wx:for="{{classTimes}}" wx:key="index" class="time-slot">
            {{item.name}}
          </view>
        </view>

        <!-- 课程表格 -->
        <view class="classes-column">
          <view wx:for="{{filteredSchedule}}" wx:for-item="day" wx:for-index="dayIndex" wx:key="dayIndex" class="day-column">
            <view wx:for="{{day.classes}}" wx:for-item="classList" wx:for-index="timeIndex" wx:key="timeIndex" class="class-slot">
              <view wx:for="{{classList}}" wx:for-item="classItem" wx:key="id" 
                    class="class-item {{classItem.course ? 'has-class' : ''}}"
                    data-day="{{dayIndex}}" data-time="{{timeIndex}}" data-index="{{index}}" bindtap="showClassDetail">
                <text class="course-name" wx:if="{{classItem.course}}">{{classItem.course}}</text>
                <text class="class-room" wx:if="{{classItem.course}}">{{classItem.room}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 设置周数面板 -->
  <view class="modal" wx:if="{{showWeekSetting}}" catchtap="hideWeekSettingPanel">
    <view class="modal-content setting-panel" catchtap="stopPropagation">
      <view class="modal-header">
        <text>设置当前周数</text>
        <text class="close-btn" catchtap="hideWeekSettingPanel">×</text>
      </view>
      <view class="modal-body">
        <text class="tip-text">设置当前是第几周，系统会自动推算后续周数</text>
        <slider value="{{tempCurrentWeek}}" min="1" max="20" show-value bindchange="setTempWeek" />
        <view class="button-group">
          <button class="btn-cancel" bindtap="hideWeekSettingPanel">取消</button>
          <button class="btn-confirm" bindtap="confirmWeekSetting">确定</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态提示 -->
  <view wx:if="{{isEmpty}}" class="empty-tip">
    <image src="/images/empty.png" class="empty-img"></image>
    <text>当前学期暂无排课</text>
    <button class="refresh-btn-large" bindtap="onRefresh">重新加载</button>
  </view>

  <!-- 课程详情弹窗 -->
  <view class="modal" wx:if="{{showModal}}" catchtap="hideModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text>课程详情</text>
        <text class="close-btn" catchtap="hideModal">×</text>
      </view>
      <view class="modal-body">
        <view class="detail-item">
          <text class="label">课程：</text>
          <text class="value">{{currentClass.course}}</text>
        </view>
        <view class="detail-item">
          <text class="label">教师：</text>
          <text class="value">{{currentClass.teacher}}</text>
        </view>
        <view class="detail-item">
          <text class="label">教室：</text>
          <text class="value">{{currentClass.room}}</text>
        </view>
        <view class="detail-item">
          <text class="label">周次：</text>
          <text class="value">{{currentClass.weeks}}</text>
        </view>
        <view class="detail-item">
          <text class="label">时间：</text>
          <text class="value">{{currentClass.time}}</text>
        </view>
      </view>
    </view>
  </view>
</view>